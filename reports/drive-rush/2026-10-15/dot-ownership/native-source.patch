+++ b/repentogon/Patches/StatusAttribution.h
@@ -0,0 +1,9 @@
+#pragma once
+struct Entity;
+struct EntityRef;
+namespace status_attribution {
+bool Install();
+int Version();
+int CurrentKind(Entity* entity, EntityRef* source);
+void Copy(Entity* from, Entity* to, bool overwrite);
+}
